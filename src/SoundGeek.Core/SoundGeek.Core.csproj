<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundGeek.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Apache-2.0. The speech noise model runs through this. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped product is built on Windows. The Linux runtime is here so the checks in
         tests/ can run the model itself on a CI runner rather than skipping it. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.5"
                      Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="1.13.5"
                      Condition="'$(OS)' != 'Windows_NT'" />
  </ItemGroup>
</Project>
